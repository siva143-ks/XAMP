if ($_SERVER['REQUEST_METHOD'] == 'POST') {
    // Get the raw POST data
    $data = json_decode(file_get_contents('php://input'), true);

    // Connect to your database
    $mysqli = new mysqli("localhost", "username", "password", "database");

    if ($mysqli->connect_error) {
        die("Connection failed: " . $mysqli->connect_error);
    }

    // Get player data from the POST request
    $player_id = $mysqli->real_escape_string($data['player_id']);
    $score = $mysqli->real_escape_string($data['score']);

    // Insert the data into the database
    $sql = "INSERT INTO scores (player_id, score) VALUES ('$player_id', '$score')";
    if ($mysqli->query($sql) === TRUE) {
        echo json_encode(["status" => "success"]);
    } else {
        echo json_encode(["status" => "error", "message" => "Error: " . $mysqli->error]);
    }

    // Close the connection
    $mysqli->close();
}
